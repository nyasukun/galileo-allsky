# Collector-only configuration.
# Hermes Agent uses its own $HERMES_HOME/.env through hermes-galileo.
# Do not add a Hermes route to this file.
# Copy this file OUTSIDE the repository, for example:
#   ~/.config/galileo-allsky/collector.env
# Then run: chmod 600 ~/.config/galileo-allsky/collector.env

# Required Galileo credentials and routing.
GALILEO_API_KEY=
GALILEO_PROJECT=galileo-allsky
GALILEO_OTLP_TRACES_ENDPOINT=https://api.galileo.ai/otel/v1/traces

# One allowlisted source ID maps to one Galileo Log stream.
# The values may be the same if you intentionally want to combine surfaces.
GALILEO_CODEX_LOG_STREAM=codex
GALILEO_CHATGPT_LOG_STREAM=chatgpt
GALILEO_CLAUDE_CODE_LOG_STREAM=claude-code
GALILEO_CLAUDE_COWORK_LOG_STREAM=claude-cowork
GALILEO_CODEX_CLI_LOG_STREAM=codex-cli
GALILEO_CLAUDE_CODE_CLI_LOG_STREAM=claude-code-cli

# The receiver is always bound to 127.0.0.1. Only the port is configurable.
ALLSKY_LISTEN_PORT=4318

# Use a dedicated random value in production. If omitted, GALILEO_API_KEY is
# used as the HMAC key. Changing this value changes exported pseudonyms.
ALLSKY_PSEUDONYM_SECRET=

# Set true only after enabling content capture in the Agent.
# See docs/07-content-capture.md. Identity fields are still pseudonymized,
# and known secrets/reasoning are still redacted.
ALLSKY_CAPTURE_CONTENT=false
ALLSKY_MAX_CONTENT_CHARS=12000

# Receiver and upstream bounds.
ALLSKY_MAX_REQUEST_BYTES=8388608
ALLSKY_MAX_ITEMS_PER_REQUEST=10000
ALLSKY_MAX_OUTPUT_BYTES=16777216
ALLSKY_FORWARD_TIMEOUT_SECONDS=5

# Codex exports about one log record per OTLP request. A Galileo trace is
# single-shot, so the collector holds a conversation turn in memory and ships
# it as one request. Held turns are lost if the process dies; set false to
# forward immediately and accept fragmented traces instead.
# A log record the allowlist cannot name is not an agent operation. Measured on
# real traffic, forwarding these produced 85% of Codex's AGENT spans (its
# startup and auth telemetry) as empty `invoke_agent` spans. Set true to keep
# them while diagnosing an agent that renamed its events.
ALLSKY_FORWARD_UNIDENTIFIED_LOGS=false

ALLSKY_AGGREGATE_TURNS=true
ALLSKY_TURN_IDLE_SECONDS=12
ALLSKY_MAX_TURN_RECORDS=2000
ALLSKY_MAX_BUFFERED_RECORDS=50000

# Test-only escape hatch for a trusted HTTP Galileo stub.
# Never enable this for Galileo Cloud.
# ALLSKY_ALLOW_INSECURE_UPSTREAM=true
